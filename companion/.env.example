# 网页与 Songloft 插件双端模式。复制为 .env 后修改用户名和密码。
PANEL_USERNAME=bluezadmin
PANEL_PASSWORD=请替换为管理密码

# 允许可信 LAN 访问网页；同机 Songloft 插件仍通过 127.0.0.1 访问同一容器。
WEB_BIND=0.0.0.0
WEB_PORT=8088

# 默认使用 Docker Hub 正式镜像；需要固定版本时改为 dlaq/songloft-bluez-control:1.2.0。
BLUEZ_IMAGE=dlaq/songloft-bluez-control:latest

# 默认使用 hci0；只有多蓝牙适配器时才需要修改。
BLUEZ_ADAPTER=hci0
SCAN_SECONDS=20
