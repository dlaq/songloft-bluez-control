# 安全默认模板（与 .env.plugin.example 相同）。独立网页请改用 .env.web.example。
# 复制为 .env 后修改。密码至少 12 位，建议只使用大小写字母和数字。
PANEL_USERNAME=bluezadmin
PANEL_PASSWORD=请替换为至少12位随机密码

# Songloft 与本服务在同一台主机时保持 127.0.0.1；只有确需独立网页访问才改为 LAN 地址。
WEB_BIND=127.0.0.1
WEB_PORT=8088

# 默认使用 Docker Hub 正式镜像；需要固定版本时改为 dlaq/songloft-bluez-control:1.1.0。
BLUEZ_IMAGE=dlaq/songloft-bluez-control:latest

# 默认使用 hci0；只有多蓝牙适配器时才需要修改。
BLUEZ_ADAPTER=hci0
SCAN_SECONDS=20
